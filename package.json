{
  "name": "copilot-changelog-cli",
  "version": "0.0.1",
  "description": "Generate Copilot-enriched presentations and offline websites from the GitHub Copilot changelog.",
  "homepage": "https://congiuluc.github.io/GitHub-Updates-CLI/",
  "repository": {
    "type": "git",
    "url": "https://github.com/congiuluc/GitHub-Updates-CLI.git"
  },
  "bugs": {
    "url": "https://github.com/congiuluc/GitHub-Updates-CLI/issues"
  },
  "type": "module",
  "bin": {
    "copilot-changelog": "./dist/cli.js"
  },
  "files": [
    "assets",
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "prepack": "npm run build && node packaging/prepare-npm-package.mjs",
    "postpack": "node packaging/prepare-npm-package.mjs --restore",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\packaging\\build-installer.ps1",
    "build:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\packaging\\build-portable.ps1",
    "build:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\packaging\\build-installer.ps1",
    "build:linux": "bash ./packaging/build-linux.sh",
    "build:macos": "bash ./packaging/build-macos.sh"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "overrides": {
    "image-size": "2.0.4"
  },
  "bundleDependencies": [
    "pptxgenjs"
  ],
  "dependencies": {
    "@github/copilot": "1.0.80",
    "@github/copilot-sdk": "^1.0.11",
    "cheerio": "^1.2.0",
    "commander": "^15.0.0",
    "fast-xml-parser": "^5.2.5",
    "jszip": "^3.10.1",
    "pptxgenjs": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^5.0.2"
  }
}
